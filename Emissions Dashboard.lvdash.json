{
  "datasets": [
    {
      "name": "af7fc5a9",
      "displayName": "Location Data",
      "queryLines": [
        "SELECT latitude,\r\n",
        "longitude,\r\n",
        "`GHG emissions mtons CO2e` AS Emmissions\r\n",
        "FROM emissions.default.emissions_data"
      ]
    },
    {
      "name": "4d70c706",
      "displayName": "Emissions per Person",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "population,\r\n",
        "try_cast(replace(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / NULLIF(population, 0) AS emmissions_per_person\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "ORDER BY emmissions_per_person DESC"
      ]
    },
    {
      "name": "952c87fc",
      "displayName": "Total Emissinos Per State",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE))  AS Total_Emmissions\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_Emmissions DESC\r\n",
        "LIMIT 10\r\n"
      ]
    },
    {
      "name": "d4712cc7",
      "displayName": "County Shaming",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "    population,\r\n",
        "    CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS total_emissions\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "ORDER BY total_emissions DESC\r\n",
        "LIMIT 10\r\n",
        "  \r\n",
        "\r\n"
      ]
    }
  ],
